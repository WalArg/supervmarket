# ───────────── LOCAL (por defecto) ─────────────
# SQLite: no hay que instalar nada. El scraper y la API comparten este archivo
# (se crea en la raíz del repo). Datos REALES de los supermercados.
DATABASE_URL=sqlite:///./supervmarket.db

# ───────────── PRODUCCIÓN (cuando migres) ─────────────
# Postgres gestionado (Neon/Supabase). Usá la cadena POOLED.
# DATABASE_URL=postgresql://usuario:password@host-pooler/db?sslmode=require

# Opcional: restringir CORS de la API (por defecto *)
# CORS_ORIGINS=https://tu-dominio.vercel.app
